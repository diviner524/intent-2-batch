{
  "priorityPolicy": {
    "policyType": "FIFO"
  },
  "taskGroups": [
    {
      "taskSpec": {
        "runnables": [
          {
            "script": {
              "text": "sleep 30 seconds"
            }
          }
        ],
        "computeResource": {
          "cpuMilli": 2000,
          "memoryMib": 2048
        },
        "maxRetryCount": 2,
        "maxRunDuration": "600s"
      },
      "taskCount": 4,
      "parallelism": 4
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "policy": {
          "machineType": "n2d-highmem-4",
          "provisioningModel": "PREEMPTIBLE"
        }
      }
    ],
    "location": {
      "allowedLocations": ["regions/us-central1"] 
    }
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}
